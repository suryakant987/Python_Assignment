# Copy this file to .env and replace every placeholder.
# Never commit real passwords, secrets or production hosts.

# ---------------------------------------------------------------------------
# PostgreSQL (local install shown in pgAdmin)
# ---------------------------------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains @ # / etc, URL-encode it (e.g. @ -> %40).
#
# After installing PostgreSQL Server locally:
#   1. Register the server in pgAdmin (localhost, check the real port in
#      postgresql.conf — this machine uses 5433)
#   2. python scripts/setup_local_database.py
#   3. Keep DATABASE_URL as below (or match what the setup script created)
DATABASE_URL=postgresql+psycopg://asset_registry:assetreg123@localhost:5433/asset_registry

# Used only by scripts/setup_local_database.py to create the app role/DB.
# This is your PostgreSQL superuser from the Windows installer (usually postgres).
POSTGRES_ADMIN_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/postgres

# Signing secret for login credentials. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# How long a sign-in credential remains valid, in minutes.
JWT_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call this API (the web map).
CORS_ORIGINS=http://localhost:3000

# Maximum requests per caller per minute. Status endpoint is exempt.
RATE_LIMIT_PER_MINUTE=60

# Seconds to keep the summary report in cache.
SUMMARY_CACHE_SECONDS=60

# Created / password-synced automatically when the API starts.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
